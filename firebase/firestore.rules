rules_version = '2';
// 宿のはじめて帳 本番のアクセスルール
// 役割は、ログインしたときのカスタムクレーム（role と inn）で決まる。
//   staff    : その宿の新人スタッフ。招待リンクから入る（名前のないアカウント）
//   admin    : その宿の管理者。運営者がメールアドレスで追加する
//   operator : 運営者（吉田）。すべての宿
//   agency   : 派遣会社の担当者。自社から送った人の、教材の進み具合だけを読める
// スタッフの印には、person（受け入れ一覧のどの人か）と kiosk（休憩室の共有タブレット）が付くことがある。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isOperator() { return role() == 'operator'; }
    function member(inn) { return isOperator() || (signedIn() && request.auth.token.get('inn', '') == inn && role() in ['staff', 'admin']); }
    function admin(inn) { return isOperator() || (signedIn() && request.auth.token.get('inn', '') == inn && role() == 'admin'); }

    // 宿の中のデータ
    match /inns/{inn} {

      // スタッフが書くもの：質問、施設あての声
      match /questions/{id} {
        allow read: if member(inn);
        allow create: if member(inn);
        // スタッフは「違う」の評価だけ。回答や対応済みは管理者
        allow update: if admin(inn)
          || (member(inn) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'fb']));
        allow delete: if admin(inn);
      }
      match /innvoices/{id} {
        allow create: if member(inn);
        allow read, delete: if admin(inn);
      }

      // 管理者が書いて、スタッフが読むもの
      match /{coll}/{id} {
        allow read: if member(inn) && coll in ['learned', 'proposals', 'cards', 'notices', 'settings', 'relays'];
        allow write: if admin(inn) && coll in ['learned', 'proposals', 'cards', 'notices', 'people', 'settings'];
      }
      // 運営者の作業時間：運営者だけ
      match /worklog/{id} {
        allow read, write: if isOperator();
      }
      // 効果の数字（導入前の基準値、費用の設定）：管理者と運営者だけ
      match /metrics/{id} {
        allow read, write: if admin(inn);
      }
      // 学習の記録：スタッフは足すだけ。名前や番号は入れない。読めるのは管理者と運営者
      match /learnlog/{id} {
        allow create: if member(inn)
          && request.resource.data.keys().hasOnly(['t', 'l', 'q', 'c', 'ok', 'at'])
          && request.resource.data.t in ['done', 'quiz', 'card'];
        allow read, delete: if admin(inn);
      }
      // 人手の見通しと人材の依頼：管理者と運営者だけ。スタッフは読めない
      match /staffing/{id} {
        allow read, write: if admin(inn);
      }
      match /orders/{id} {
        allow read, write: if admin(inn);
      }
      // 受け入れ一覧：管理者が読み書きする。スタッフが読めるのは、自分につながった1人分だけ
      match /people/{id} {
        allow read: if admin(inn) || (member(inn) && request.auth.token.get('person', '') == id);
      }
      // 教材の進み具合（見終わった教材と、終えたテストの番号だけ。点数は入れない）
      // 本人は自分の分を直せる。派遣会社は、自社から送った人の分だけ読める
      match /progress/{pid} {
        allow read: if admin(inn)
          || (member(inn) && request.auth.token.get('person', '') == pid)
          || (role() == 'agency' && request.auth.token.get('inn', '') == inn && resource.data.agency == request.auth.token.get('agency', '-'));
        allow update: if member(inn) && request.auth.token.get('person', '') == pid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'quiz', 'at']);
        allow delete: if admin(inn);
      }
      // 外部の相談窓口から施設へ伝える文は、運営者だけが書く
      match /relays/{id} {
        allow write: if isOperator();
      }

      // 外部の相談窓口の声：書けるのは本人、読めるのは本人と運営者だけ（施設の管理者も読めない）
      // 1つの声が1つの文書（id は「送った人の番号_時刻」）。スタッフは書くだけで、読み返せない（共有タブレットで前の人の声が見えないように）
      match /voices/{vid} {
        allow read, update, delete: if isOperator();
        allow create: if member(inn) && vid.matches(request.auth.uid + '_[0-9]+')
          && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'items']);
      }

      // 招待の合言葉と、AIの使用回数はサーバーだけが扱う
      match /private/{id} {
        allow read, write: if false;
      }
    }

    // それ以外は、すべて禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
